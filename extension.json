{
	"name": "CloneDiff",
	"version": "0.2",
	"author": [
		"Yaron Koren"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:CloneDiff",
	"descriptionmsg": "clonediff-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "specialpage",
	"requires": {
		"MediaWiki": ">= 1.42.0"
	},
	"GroupPermissions": {
		"sysop": {
			"clonediff": true
		}
	},
	"AvailableRights": [
		"clonediff"
	],
	"SpecialPages": {
		"CloneDiff": {
			"class": "SpecialCloneDiff",
			"services": [
				"JobQueueGroup",
				"DBLoadBalancer",
				"RevisionLookup",
				"SearchEngineConfig"
			]
		}
	},
	"JobClasses": {
		"importFromClone": "ImportFromCloneJob"
	},
	"MessagesDirs": {
		"CloneDiff": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"CloneDiffAlias": "CloneDiff.alias.php"
	},
	"AutoloadClasses": {
		"CloneDiffHooks": "includes/CloneDiffHooks.php",
		"SpecialCloneDiff": "includes/SpecialCloneDiff.php",
		"ImportFromCloneJob": "includes/ImportFromCloneJob.php"
	},
	"HookHandlers": {
		"main": {
			"class": "CloneDiffHooks"
		},
		"adminlinks": {
			"class": "AdminLinksHooks"
		}
	},
	"Hooks": {
		"AdminLinks": "adminlinks",
		"SkinBuildSidebar": "main"
	},
	"config": {
		"CloneDiffWikis": []
	},
	"manifest_version": 1
}
